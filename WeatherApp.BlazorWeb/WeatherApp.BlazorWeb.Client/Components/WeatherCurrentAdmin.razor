@using WeatherApp.Shared.Models.Dto.WeatherCurrent

<MudContainer Class="mt-4">
    <MudTable Items="weatherCurrents" Hover="true" Bordered="true">
        <HeaderContent>
            <MudTh>Email</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Country</MudTh>
            <MudTh>Local Time</MudTh>
            <MudTh>Current Condition</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">@context.AccountEmail</MudTd>
            <MudTd DataLabel="Location">@context.Location?.Name</MudTd>
            <MudTd DataLabel="Country">@context.Location?.Country</MudTd>
            <MudTd DataLabel="Local Time">@context.Location?.Localtime</MudTd>
            <MudTd DataLabel="Current Condition">@context.Current?.Condition?.Text @context.Current?.TemperatureCelsius&deg;C</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    [Parameter]
    public IEnumerable<WeatherCurrentBlazorDto> weatherCurrents { get; set; }
}
