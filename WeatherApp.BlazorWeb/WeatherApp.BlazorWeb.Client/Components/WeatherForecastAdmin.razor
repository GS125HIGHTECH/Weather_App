@using WeatherApp.Shared.Models.Dto.WeatherForecast

<MudContainer Class="mt-4">
    <MudTable Items="weatherForecasts" Hover="true" Bordered="true">
        <HeaderContent>
            <MudTh>Email</MudTh>
            <MudTh>Location</MudTh>
            <MudTh>Country</MudTh>
            <MudTh>Current Condition</MudTh>
            <MudTh>Forecast</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">@context.AccountEmail</MudTd>
            <MudTd DataLabel="Location">@context.Location?.Name</MudTd>
            <MudTd DataLabel="Country">@context.Location?.Country</MudTd>
            <MudTd DataLabel="Current Condition">@context.Current?.Condition?.Text @context.Current?.TemperatureCelsius&deg;C</MudTd>
            <MudTd DataLabel="Forecast">
                <MudList T="ForecastDayDto">
                    @if (context.ForecastDays != null)
                    {
                        @foreach (var day in context.ForecastDays)
                        {
                            <MudListItem>@day.Date!.Value.Date.ToShortDateString()</MudListItem>
                        }
                    }
                </MudList>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    [Parameter]
    public IEnumerable<WeatherForecastBlazorDto> weatherForecasts { get; set; }
}
