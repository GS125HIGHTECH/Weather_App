@using WeatherApp.Shared.Models.Dto.WeatherForecast

<div class="container">
    @if (weatherForecasts == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Country</th>
                    <th>Current Condition</th>
                    <th>Forecast</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in weatherForecasts)
                {
                    <tr>
                        <td>@item.AccountEmail</td>
                        <td>@item.Location?.Name</td>
                        <td>@item.Location?.Country</td>
                        <td>@item.Current?.Condition?.Text @item.Current?.TemperatureCelsius&deg;C</td>
                        <td>
                            <ul>
                                @if (item.ForecastDays != null)
                                {
                                    @foreach (var day in item.ForecastDays)
                                    {
                                        <li>@day.Date!.Value.Date.ToShortDateString()</li>
                                    }
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<WeatherForecastBlazorDto> weatherForecasts { get; set; }
}
