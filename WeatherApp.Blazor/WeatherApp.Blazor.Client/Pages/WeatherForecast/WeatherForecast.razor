@using WeatherApp.Shared.Models.Dto.WeatherForecast

@rendermode InteractiveAuto

<div class="container">
    @foreach (var locationGroup in weatherForecasts.GroupBy(w => w.Location?.Name))
    {
        <div>
            <h2 class="user-select-none" role="button" @onclick="() => ToggleLocation(locationGroup.Key)">
                @locationGroup.Key
            </h2>
            @if (expandedLocations.Contains(locationGroup.Key))
            {
                <div>
                    @foreach (var weather in locationGroup)
                    {
                        <div class="card mb-3">
                            <div class="card-header user-select-none" role="button" @onclick="() => ToggleWeather(weather.Id)">
                                <p>@weather.Location?.Localtime?.ToShortDateString()<span class="px-2"></span>@weather.Location?.Localtime?.ToShortTimeString()</p>
                                <p>
                                    <img src="@weather.Current?.Condition?.Icon" alt="@weather.Current?.Condition?.Text" />
                                    @weather.Current?.TemperatureCelsius&deg;C
                                    <span class="float-end">
                                        <i class="bi @(expandedWeatherIds.Contains(weather.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                    </span>
                                </p>
                                <p class="mb-0">UV Index: @weather.Current?.UVIndex<span class="px-2"></span>Humidity: @weather.Current?.Humidity%</p>
                            </div>
                            @if (expandedWeatherIds.Contains(weather.Id))
                            {
                                <div class="card-body">
                                    <p>Country: @weather.Location?.Country</p>

                                    <div class="d-md-inline-block">
                                        <p>Temperature: @weather.Current?.TemperatureCelsius&deg;C<span class="px-1"></span>@weather.Current?.TemperatureFahrenheit&deg;F</p>
                                    </div>
                                    <div class="d-md-inline-block">
                                        <p class="px-md-4">Feels Like: @weather.Current?.FeelsLikeTemperatureCelsius&deg;C<span class="px-1"></span>@weather.Current?.FeelsLikeTemperatureFahrenheit&deg;F</p>
                                    </div>

                                    <p>Wind Speed: @weather.Current?.WindKPH km/h<span class="px-1"></span>@weather.Current?.WindMPH mph</p>
                                    <p>Pressure: @weather.Current?.PressureMilibars hPa</p>
                                    <p>Visibility: @weather.Current?.VisibilityKilometers km</p>

                                    <div class="user-select-none">
                                        <h5 class="pt-3 current-date">@weather.ForecastDays.FirstOrDefault()?.Date.Value.ToShortDateString()</h5>
                                        <div class="d-flex overflow-auto forecast-container" style="scroll-snap-type: x mandatory;">
                                            @foreach (var day in weather.ForecastDays)
                                            {
                                                foreach (var hour in day.ForecastHours)
                                                {
                                                    <div class="card me-2 text-center forecast-hour" data-date="@day.Date.Value.ToShortDateString()" style="min-width: 90px; scroll-snap-align: start;">
                                                        <div class="card-body">
                                                            <p>@hour.Time.Value.ToShortTimeString()</p>
                                                            <img src="@hour.Condition?.Icon" alt="@hour.Condition?.Text" class="img-fluid mb-2" />
                                                            <p class="mb-0">@hour.TemperatureCelsius&deg;C</p>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<WeatherForecastBlazorDto> weatherForecasts { get; set; }

    private HashSet<string> expandedLocations = new HashSet<string>();
    private HashSet<long> expandedWeatherIds = new HashSet<long>();

    protected override void OnInitialized()
    {
        expandedLocations = weatherForecasts
            .Select(w => w.Location?.Name)
            .Where(name => !string.IsNullOrEmpty(name))
            .Cast<string>()
            .ToHashSet();
    }

    private void ToggleLocation(string locationName)
    {
        if (!expandedLocations.Add(locationName))
        {
            expandedLocations.Remove(locationName);
        }
    }

    private void ToggleWeather(long weatherId)
    {
        if (!expandedWeatherIds.Add(weatherId))
        {
            expandedWeatherIds.Remove(weatherId);
        }
    }
}